# paylod MCP server configuration.
# Copy to .env for local development. NEVER commit real keys.

# Required — your paylod merchant API key.
#   mp_test_...  → sandbox (no real money moves)
#   mp_live_...  → production (real money)
PAYLOD_API_KEY=mp_test_your_key_here

# Optional — override the edge functions base URL.
# PAYLOD_BASE_URL=https://paylod.dev/functions/v1

# Optional — tool allowlist. Comma list of tool names / categories, or 'all' / 'default'.
# Default (unset) enables read + local + qr + sandbox tools.
# Money-moving/elevated tools require explicit opt-in, e.g.:
#   PAYLOD_TOOLS=default,request_stk_push
#   PAYLOD_TOOLS=all
# PAYLOD_TOOLS=default

# Optional — Supabase session JWT for the sandbox simulate_* tools and mint_api_key.
# (paylod's simulator + mint-key are dashboard-session authed, not API-key authed.)
# PAYLOD_SESSION_TOKEN=

# Optional — network timeout in ms (default 30000).
# PAYLOD_TIMEOUT_MS=30000
